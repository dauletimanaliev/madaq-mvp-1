// Madaq — schema
// Авторы, книги, главы, пользователи, прогресс чтения,
// закладки, выделения и очередь обработки загрузок.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum HighlightType {
  protein
  carbohydrate
  fat
  vitamin
  fiber
}

enum UploadJobStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

// ──────────────────────────────
// Author 1 ─── N Book
// ──────────────────────────────
model Author {
  id        String   @id @default(cuid())
  name      String
  bio       String?
  photoUrl  String?  @map("photo_url")
  createdAt DateTime @default(now()) @map("created_at")

  books Book[]

  @@map("authors")
}

// ──────────────────────────────
// Book 1 ─── N Chapter
// ──────────────────────────────
model Book {
  id            String   @id @default(cuid())
  title         String
  description   String?
  coverUrl      String?  @map("cover_url")
  language      String   @default("ru")
  publishedYear Int?     @map("published_year")
  createdAt     DateTime @default(now()) @map("created_at")

  // ── Ingestion Pipeline fields (ТЗ §1, §2, §5) ──
  fileHashSha256 String?  @unique @map("file_hash_sha256") // SHA-256 дедупликация
  fileSizeBytes  Int?     @map("file_size_bytes")           // размер исходного файла
  totalPages     Int?     @map("total_pages")               // количество страниц PDF
  isLinearized   Boolean  @default(false) @map("is_linearized") // Fast Web View
  storageS3Key   String?  @map("storage_s3_key")            // путь к PDF в S3/Supabase Storage

  authorId String @map("author_id")
  author   Author @relation(fields: [authorId], references: [id])

  chapters        Chapter[]
  pages           BookPage[]
  readingProgress ReadingProgress[]
  bookmarks       Bookmark[]
  highlights      Highlight[]
  uploadJob       UploadJob?
  userLibraries   UserLibrary[]

  @@index([authorId])
  @@map("books")
}

// ──────────────────────────────
// Chapter (принадлежит одной книге)
// ──────────────────────────────
model Chapter {
  id        String   @id @default(cuid())
  number    Int
  title     String?
  content   String // текст главы, не всей книги целиком
  createdAt DateTime @default(now()) @map("created_at")

  bookId String @map("book_id")
  book   Book   @relation(fields: [bookId], references: [id])

  readingProgress ReadingProgress[]
  bookmarks       Bookmark[]
  highlights      Highlight[]

  @@unique([bookId, number]) // у книги не может быть двух четвёртых глав
  @@map("chapters")
}

// ──────────────────────────────
// User 1 ─── N ReadingProgress
// User 1 ─── N Bookmark
// ──────────────────────────────
model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  googleId  String?  @unique @map("google_id")
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")

  readingProgress ReadingProgress[]
  bookmarks       Bookmark[]
  highlights      Highlight[]
  userLibrary     UserLibrary[]

  @@map("users")
}

// ──────────────────────────────
// ReadingProgress
// Один пользователь = одна активная позиция на книгу.
// Поэтому @@unique([userId, bookId]) — при обновлении прогресса
// делаем upsert, а не плодим новые строки.
// ──────────────────────────────
model ReadingProgress {
  id              String   @id @default(cuid())
  position        Int      @default(0) // позиция в тексте главы (символы)
  progressPercent Float    @default(0) @map("progress_percent")
  lastReadPage    Int?     @default(1) @map("last_read_page")
  lastReadAt      DateTime @default(now()) @map("last_read_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  userId    String  @map("user_id")
  user      User    @relation(fields: [userId], references: [id])
  bookId    String  @map("book_id")
  book      Book    @relation(fields: [bookId], references: [id])
  chapterId String  @map("chapter_id")
  chapter   Chapter @relation(fields: [chapterId], references: [id])

  @@unique([userId, bookId])
  @@index([bookId])
  @@map("reading_progress")
}

// ──────────────────────────────
// Bookmark
// В отличие от ReadingProgress — пользователь может
// иметь сколько угодно закладок в одной книге.
// ──────────────────────────────
model Bookmark {
  id        String   @id @default(cuid())
  position  Int
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  userId    String  @map("user_id")
  user      User    @relation(fields: [userId], references: [id])
  bookId    String  @map("book_id")
  book      Book    @relation(fields: [bookId], references: [id])
  chapterId String  @map("chapter_id")
  chapter   Chapter @relation(fields: [chapterId], references: [id])

  @@index([userId, bookId])
  @@map("bookmarks")
}

// ──────────────────────────────
// Highlight
// Canonical UTF-16 offsets in Chapter.content. Overlapping ranges are
// rejected in the server layer for the MVP. `legacyColor` is populated only
// for unclassified highlights imported from the previous color-only system.
// ──────────────────────────────
model Highlight {
  id            String         @id @default(cuid())
  startPosition Int            @map("start_position")
  endPosition   Int            @map("end_position")
  type          HighlightType?
  legacyColor   String?        @map("legacy_color")
  createdAt     DateTime       @default(now()) @map("created_at")

  userId    String  @map("user_id")
  user      User    @relation(fields: [userId], references: [id])
  bookId    String  @map("book_id")
  book      Book    @relation(fields: [bookId], references: [id])
  chapterId String  @map("chapter_id")
  chapter   Chapter @relation(fields: [chapterId], references: [id])

  @@unique([userId, chapterId, startPosition, endPosition])
  @@index([userId, chapterId])
  @@index([bookId])
  @@map("highlights")
}

// ──────────────────────────────
// UploadJob (ТЗ §1, §5)
// Асинхронная очередь обработки загрузок.
// Статусы: PENDING → PROCESSING → SUCCESS / FAILED
// ──────────────────────────────
model UploadJob {
  id        String          @id @default(cuid())
  status    UploadJobStatus @default(PENDING)
  fileName  String          @map("file_name")
  fileSize  Int             @map("file_size")          // размер в байтах
  step      Int             @default(0)                // текущий шаг конвейера (0–5)
  stepText  String?         @map("step_text")          // "Загружаем файл…", "Извлекаем текст…" и т.д.
  errorLog  String?         @map("error_log")          // лог ошибки при FAILED
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  bookId String? @unique @map("book_id") // появляется после успешной обработки
  book   Book?   @relation(fields: [bookId], references: [id])

  @@index([status])
  @@map("upload_jobs")
}

// ──────────────────────────────
// BookPage (ТЗ §1, §4)
// Постраничный индекс текста для быстрого поиска внутри книги
// ──────────────────────────────
model BookPage {
  id         String   @id @default(cuid())
  pageNumber Int      @map("page_number")
  content    String   // текст страницы
  bookId     String   @map("book_id")
  book       Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([bookId, pageNumber])
  @@index([bookId])
  @@map("book_pages")
}

// ──────────────────────────────
// UserLibrary (ТЗ §1, §5)
// Книги в личной библиотеке пользователя с трекингом прогресса чтения
// ──────────────────────────────
model UserLibrary {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId       String   @map("book_id")
  book         Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  lastReadPage Int      @default(1) @map("last_read_page")
  progressPct  Float    @default(0) @map("progress_pct")
  lastReadAt   DateTime @default(now()) @map("last_read_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([userId, bookId])
  @@index([userId])
  @@index([bookId])
  @@map("user_library")
}
